{
  "manifest_schema_version": 3,
  "sdk_version": "5.13.0",
  "app_id": "1password-connector",
  "version": "0.1.0",
  "name": "1Password",
  "description": "Connect your own 1Password Connect Server (self-hosted, Bearer access token) to read and manage vaults, items (logins, passwords, secure notes, API credentials), and file attachments -- full read/write plus value-add vault health and stale-item reports. Item secrets are never logged.",
  "icon": "icon.svg",
  "actions_explicit": true,
  "system": false,
  "capabilities": [
    "1password:read",
    "1password:write"
  ],
  "tools": [
    {
      "name": "connect_onepassword",
      "description": "Connect your own 1Password Connect Server (self-hosted, Bearer access token) by saving its base URL and access token, after checking it actually works.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "1password.connection.created"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "label": {
            "default": "",
            "description": "A friendly name for this Connect server, e.g. 'Prod vaults'.",
            "title": "Label",
            "type": "string"
          },
          "base_url": {
            "description": "Your 1Password Connect server's base URL, e.g. https://connect.yourcompany.com",
            "title": "Base Url",
            "type": "string"
          },
          "access_token": {
            "description": "The access token issued when you set up this Connect server (1Password Business admin console).",
            "title": "Access Token",
            "type": "string"
          },
          "verify_ssl": {
            "default": true,
            "description": "Verify the Connect server's TLS certificate. Turn off only for self-signed certs in trusted internal networks.",
            "title": "Verify Ssl",
            "type": "boolean"
          }
        },
        "required": [
          "base_url",
          "access_token"
        ],
        "title": "ConnectOnePasswordParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "connection_id": {
            "default": "",
            "title": "Connection Id",
            "type": "string"
          },
          "label": {
            "default": "",
            "title": "Label",
            "type": "string"
          },
          "vault_count": {
            "default": 0,
            "title": "Vault Count",
            "type": "integer"
          }
        },
        "title": "ConnectOnePasswordResult",
        "type": "object"
      },
      "event": "1password-connector.connect",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "tool_1password-connector_chat"
    },
